# Copy this file to .env.local and fill in your key.
#   cp .env.example .env.local
# Get a key at https://aistudio.google.com/apikey  (or use the key provided at the event)
GEMINI_API_KEY=

# Optional — override the model. Defaults to gemini-3.6-flash (fast, GA).
# For deeper reasoning use: gemini-3-pro
# GEMINI_MODEL=gemini-3.6-flash

# Optional — model failover chain (retries these on 429/500/503). Defaults to model + a lite fallback.
# GEMINI_MODEL_CHAIN=gemini-3.6-flash,gemini-3.5-flash-lite

# Demo-safety net: set to 1 to run the whole app on seeded data (no live model call), so a live
# pitch survives dead wifi / rate-limits. Leave blank normally.
# DEMO_MOCK=1
